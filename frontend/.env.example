# Firebase Web config — get these from your Firebase project settings
# (Project settings → General → Your apps → Web app → SDK config).
# These are client-side identifiers, but keep your real .env out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: server-proxy URL for higher-accuracy OCR (leave blank to use the
# in-browser engine — no key is ever exposed to the client).
VITE_OCR_PROXY_URL=

# Set to "true" to use local Firebase emulators during development.
VITE_USE_EMULATORS=false
