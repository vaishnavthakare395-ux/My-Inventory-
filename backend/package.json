{
  "name": "stockflow-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StockFlow — Firestore rules, indexes and seed/admin scripts.",
  "scripts": {
    "seed": "node scripts/seedAdmin.mjs",
    "seed:live": "node scripts/seedAdmin.mjs",
    "seed:emulator": "node scripts/seedFirestore.mjs",
    "seed:local": "node scripts/seedLocal.mjs",
    "import:products": "node scripts/importProductsCsv.mjs",
    "deploy:rules": "firebase deploy --only firestore",
    "emulators": "firebase emulators:start --only auth,firestore --import=../emulator-data --export-on-exit=../emulator-data",
    "export:data": "firebase emulators:export ../emulator-data --project demo-stockflow --force"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^12.6.0"
  }
}
